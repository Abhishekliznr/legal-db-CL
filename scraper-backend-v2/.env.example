# Database connection — discrete variables only, never a connection-string
# key (docs/scraper-backend-revamp-spec.md §3.3). Matches the convention in
# legal_liznr/legal_mvp/backend/.env.
DATABASE_TYPE=postgres
DB_HOST=localhost
DB_PORT=5434
DB_NAME=liznrlegal
DB_USER=postgres
DB_PASSWORD=changeme

# Azure Blob Storage — PDFs only in the new pipeline (no bronze/silver JSON,
# see spec §7).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_PDFS=liznr-legal-dev-judgment-pdfs

# AI extraction (Phase 3 — structured-output extraction call, spec §5.2).
# Without GROQ_API_KEY set, pipeline/extraction.py falls back to the Phase 1
# stub (pipeline/extraction_stub.py) — fine for local dev, not for production.
#
# If extraction ever fails with "404 Client Error" in the logs, GROQ_MODEL
# has gone stale (Groq's catalog changes over time) — check your account's
# current options: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

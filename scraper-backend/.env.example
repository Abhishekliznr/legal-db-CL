# Database connection — discrete variables only, never a connection-string
# key (docs/scraper-backend-revamp-spec.md §3.3). Matches the convention in
# legal_liznr/legal_mvp/backend/.env.
DATABASE_TYPE=postgres
DB_HOST=localhost
DB_PORT=5434
DB_NAME=liznrlegal
DB_USER=postgres
DB_PASSWORD=changeme

# Azure Blob Storage — PDFs only in the new pipeline (no bronze/silver JSON,
# see spec §7).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_PDFS=liznr-legal-dev-judgment-pdfs

# AI extraction (Phase 3 — structured-output extraction call, spec §5.2).
# Provider: Azure OpenAI (switched from Groq 2026-09-06 — see
# pipeline/extraction.py's module docstring for what changed in the swap).
# Without all three of these set, pipeline/extraction.py falls back to the
# Phase 1 stub (pipeline/extraction_stub.py) — fine for local dev, not for
# production.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# The DEPLOYMENT name you gave the model in Azure AI Foundry / the Azure
# OpenAI resource (e.g. "gpt-4o-deployment") — NOT a base model id like
# "gpt-4o". Azure routes by deployment name in the URL, unlike Groq/OpenAI
# where the model id is a request-body field.
AZURE_OPENAI_DEPLOYMENT=
# Must support response_format=json_object for AZURE_OPENAI_DEPLOYMENT's base
# model (gpt-4o/gpt-4o-mini/gpt-35-turbo-1106+ all support it from
# 2023-12-01-preview onward). Override if your resource needs a different one.
AZURE_OPENAI_API_VERSION=2024-10-21

# Legal NER (statute/section extraction, pipeline/legal_ner_extraction.py) --
# points at the ../legal-ner-service sibling, run separately (its own
# docker-compose.yml, port 8004; kept out of this repo's Docker image since
# it needs Python 3.10, see that service's own Dockerfile comment).
LEGAL_NER_SERVICE_URL=http://localhost:8004

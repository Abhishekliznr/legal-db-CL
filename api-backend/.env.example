# Database connection — discrete variables only, never a connection-string
# key (docs/scraper-backend-revamp-spec.md §3.3).
#
# For local standalone dev, point at this service's own docker-compose db
# (port 5435 below) and run `python -m db.init_db init`. To read
# scraper-backend's real data instead, point DB_HOST/DB_PORT at that
# service's Postgres (see its docker-compose.yml) and run
# `python -m db.init_db ensure-supplement` here instead of `init` —
# scraper-backend already owns the core schema in that setup, this just
# idempotently adds api-backend's one extra table.
DATABASE_TYPE=postgres
DB_HOST=localhost
DB_PORT=5435
DB_NAME=liznrlegal
DB_USER=postgres
DB_PASSWORD=changeme

# PDF blob URL resolution — /api/cases and /api/cases/{id} join these with
# each case's blob_pdf_id (a bare in-container path) to return blob_pdf_url.
# Left unset, blob_pdf_url is just null; blob_pdf_id is always returned as-is.
BLOB_BASE_URL=
BLOB_CONTAINER=
